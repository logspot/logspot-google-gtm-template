___TESTS___

scenarios:
- name: Injects the loader with the public key in the query
  code: |-
    let injectedUrl;
    mock('injectScript', (url, onSuccess) => {
      injectedUrl = url;
      onSuccess();
    });
    runCode({publicKey: 'pk_test123'});
    assertApi('injectScript').wasCalled();
    assertThat(injectedUrl).isEqualTo('https://cdn.logspot.io/lg.js?pk=pk_test123');
- name: Advanced fields become query params
  code: |-
    let injectedUrl;
    mock('injectScript', (url, onSuccess) => {
      injectedUrl = url;
      onSuccess();
    });
    runCode({
      publicKey: 'pk_abc',
      cookieDomain: '.example.com',
      channel: 'blog',
      consentSource: 'concord,gcm',
      consentBehavior: 'express',
      stripQueryParams: true
    });
    assertThat(injectedUrl).isEqualTo('https://cdn.logspot.io/lg.js?pk=pk_abc&domain=.example.com&channel=blog&consent_source=concord%2Cgcm&consent_behavior=express&strip_query_params=true');
- name: Empty advanced fields are omitted from the query
  code: |-
    let injectedUrl;
    mock('injectScript', (url, onSuccess) => {
      injectedUrl = url;
      onSuccess();
    });
    runCode({publicKey: 'pk_abc', cookieDomain: '', channel: undefined, stripQueryParams: false});
    assertThat(injectedUrl).isEqualTo('https://cdn.logspot.io/lg.js?pk=pk_abc');


___NOTES___

Logspot Analytics tag for Google Tag Manager. Loads cdn.logspot.io/lg.js with
the project public key (and optional config) in the src query string. Fire it on
Consent Initialization or All Pages. See integrations/google-tag-manager/README.md.
