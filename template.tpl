___SANDBOXED_JS_FOR_WEB_TEMPLATE___

const injectScript = require('injectScript');
const encodeUriComponent = require('encodeUriComponent');
const logToConsole = require('logToConsole');

// lg.js reads its config from data-* attributes on the embed tag. GTM's
// injectScript cannot set attributes, so pass config in the src query instead;
// lg.js falls back to the query when the matching attribute is absent.
let url = 'https://cdn.logspot.io/lg.js?pk=' + encodeUriComponent(data.publicKey);

const addParam = (key, value) => {
  if (value !== undefined && value !== null && value !== '') {
    url = url + '&' + key + '=' + encodeUriComponent(value);
  }
};

addParam('domain', data.cookieDomain);
addParam('channel', data.channel);
addParam('consent_source', data.consentSource);
addParam('consent_behavior', data.consentBehavior);
if (data.stripQueryParams === true) {
  addParam('strip_query_params', 'true');
}

const onFailure = () => {
  logToConsole('Logspot: failed to load lg.js from ' + url);
  data.gtmOnFailure();
};

injectScript(url, data.gtmOnSuccess, onFailure, 'logspot');


